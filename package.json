{
  "name": "uma-bot",
  "version": "0.1.0",
  "description": "Vietnamese-first Discord tournament bot for UMA Club",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "tournament",
    "esports",
    "lien-quan-mobile",
    "uma"
  ],
  "author": "Phuchello",
  "license": "UNLICENSED",
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "tournament-organizer": "^4.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
