# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_GUILD_ID=your_discord_guild_id

# Active Tournament Identity (Separated from Guild ID)
ACTIVE_TOURNAMENT_ID=uma-cup-2027
# Human-readable display name for the active tournament
TOURNAMENT_NAME=UMA Cup 2027

# Discord channel IDs (set explicitly for the intended guild)
BTC_CHANNEL_ID=your_btc_channel_id
REGISTRATION_CHANNEL_ID=your_registration_channel_id
MATCH_HUB_CHANNEL_ID=your_match_hub_channel_id
REFEREE_CHANNEL_ID=your_referee_channel_id
RESULTS_CHANNEL_ID=your_results_channel_id

# Staff Role IDs (comma-separated or single)
TOURNAMENT_ADMIN_ROLE_IDS=your_staff_role_id

# Database
DATABASE_PATH=data/tournament.sqlite

# Tournament Settings
DEFAULT_GAME=Liên Quân Mobile
MAX_TEAMS=16
STARTERS_COUNT=5
MAX_SUBSTITUTES=2

# Persona Settings
BOT_PERSONA_ENABLED=true
BOT_PERSONA_LEVEL=normal
BOT_PERSONA_GIFS_ENABLED=true
BOT_PERSONA_GIF_LEVEL=normal
BOT_PERSONA_MEDIA_DIR=/var/lib/uma-bot/media/misaka
