# Portable template only. Create /etc/uma-bot/uma-bot.env privately, root:root 0600.
# Do not source this file as shell code; dotenv/systemd read it as data.
NODE_ENV=production
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
ACTIVE_TOURNAMENT_ID=
TOURNAMENT_NAME=
DATABASE_PATH=/var/lib/uma-bot/tournament.sqlite
BTC_CHANNEL_ID=
REGISTRATION_CHANNEL_ID=
MATCH_HUB_CHANNEL_ID=
REFEREE_CHANNEL_ID=
RESULTS_CHANNEL_ID=
TOURNAMENT_ADMIN_ROLE_IDS=
DEFAULT_GAME="Liên Quân Mobile"
MAX_TEAMS=16
STARTERS_COUNT=5
MAX_SUBSTITUTES=2
